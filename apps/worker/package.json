{
  "name": "@recruitops/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude \"src/publication-pipeline.integration.test.ts\"",
    "pretest:integration": "pnpm --filter @recruitops/contracts build && pnpm --filter @recruitops/queue build",
    "test:integration": "vitest run src/publication-pipeline.integration.test.ts"
  },
  "dependencies": {
    "@recruitops/contracts": "workspace:*",
    "@recruitops/database": "workspace:*",
    "@recruitops/integrations": "workspace:*",
    "@recruitops/queue": "workspace:*",
    "@sentry/node": "^11.1.0",
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
