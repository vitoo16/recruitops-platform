# Runtime
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Supabase Auth
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase Storage signing for provider-readable private media
SUPABASE_SECRET_KEY=
PROVIDER_MEDIA_SIGNED_URL_TTL_SECONDS=900

# PostgreSQL (local Docker defaults shown)
DATABASE_URL=postgresql://recruitops:recruitops@localhost:5432/recruitops?schema=public

# Redis (local Docker default shown; hosted environment uses Render Key Value)
REDIS_URL=redis://localhost:6379

# Publication worker limits and read-only queue monitoring
PUBLICATION_WORKER_CONCURRENCY=4
PUBLICATION_WORKER_RATE_LIMIT_MAX=10
PUBLICATION_WORKER_RATE_LIMIT_DURATION_MS=1000
PUBLICATION_QUEUE_METRICS_INTERVAL_MS=60000
PUBLICATION_QUEUE_WAITING_ALERT_THRESHOLD=100
PUBLICATION_QUEUE_FAILED_ALERT_THRESHOLD=1

# Object storage / Supabase S3-compatible storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=recruitops-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Authentication
AUTH_SECRET=

# OAuth credential encryption (server-only JSON keyring; each value is a 32-byte base64 key)
OAUTH_CREDENTIAL_ACTIVE_KEY_ID=
OAUTH_CREDENTIAL_ENCRYPTION_KEYS=

# Publishing activation flags (fail closed by default)
PUBLISHING_INSTAGRAM_ENABLED=false
PUBLISHING_THREADS_ENABLED=false
PUBLISHING_LINKEDIN_ENABLED=false
PUBLISHING_TIKTOK_ENABLED=false

# Social integrations
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_API_VERSION=v26.0
META_REDIRECT_URI=http://localhost:4000/api/integrations/meta/oauth/callback
META_FRONTEND_REDIRECT_URI=http://localhost:3000/
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:4000/api/integrations/threads/oauth/callback
THREADS_FRONTEND_REDIRECT_URI=http://localhost:3000/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202609
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/integrations/linkedin/oauth/callback
LINKEDIN_FRONTEND_REDIRECT_URI=http://localhost:3000/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/api/integrations/tiktok/oauth/callback
TIKTOK_FRONTEND_REDIRECT_URI=http://localhost:3000/
ZALO_APP_ID=
ZALO_APP_SECRET=

# n8n
N8N_WEBHOOK_BASE_URL=
N8N_SHARED_SECRET=

# Optional future QStash scheduling/wake-up bridge
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Observability
SENTRY_DSN=
