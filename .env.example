# Runtime
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# PostgreSQL (local Docker defaults shown)
DATABASE_URL=postgresql://recruitops:recruitops@localhost:5432/recruitops?schema=public

# Redis (local Docker default shown; use Upstash TLS URL in hosted environments)
REDIS_URL=redis://localhost:6379

# Object storage / Supabase S3-compatible storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=recruitops-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Authentication
AUTH_SECRET=

# Social integrations
META_CLIENT_ID=
META_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=

# n8n
N8N_WEBHOOK_BASE_URL=
N8N_SHARED_SECRET=

# Upstash QStash (external scheduling/wake-up bridge for free hosted API)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Observability
SENTRY_DSN=
