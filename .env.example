# Runtime
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Supabase Auth
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL (local Docker defaults shown)
DATABASE_URL=postgresql://recruitops:recruitops@localhost:5432/recruitops?schema=public

# Redis (local Docker default shown; hosted environment uses Render Key Value)
REDIS_URL=redis://localhost:6379

# Object storage / Supabase S3-compatible storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=recruitops-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Authentication
AUTH_SECRET=

# OAuth credential encryption (server-only JSON keyring; each value is a 32-byte base64 key)
OAUTH_CREDENTIAL_ACTIVE_KEY_ID=
OAUTH_CREDENTIAL_ENCRYPTION_KEYS=

# Social integrations
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_API_VERSION=v26.0
META_REDIRECT_URI=http://localhost:4000/api/integrations/meta/oauth/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=

# n8n
N8N_WEBHOOK_BASE_URL=
N8N_SHARED_SECRET=

# Optional future QStash scheduling/wake-up bridge
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Observability
SENTRY_DSN=
