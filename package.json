{
  "name": "recruitops-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,mjs}\" \"packages/**/*.{ts,tsx,json}\" \"*.{json,yaml,yml}\" \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --write packages/integrations/src/meta-oauth.test.ts && printf '\n---PRETTIER_OUTPUT---\n' && cat packages/integrations/src/meta-oauth.test.ts && printf '\n---END_PRETTIER_OUTPUT---\n' && exit 1",
    "secrets:check": "node tooling/scripts/check-secrets.mjs",
    "db:generate": "pnpm --filter @recruitops/database prisma:generate",
    "db:validate": "pnpm --filter @recruitops/database prisma:validate",
    "infra:setup": "node tooling/scripts/init-local-infra.mjs",
    "infra:up": "pnpm infra:setup && docker compose --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml up -d",
    "infra:down": "pnpm infra:setup && docker compose --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.2",
    "typescript": "^6.0.0",
    "vitest": "^5.0.2"
  }
}
