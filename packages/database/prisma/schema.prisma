generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  OTHER
}

enum PostStatus {
  DRAFT
  READY
  ARCHIVED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  THREADS
  LINKEDIN
  TIKTOK
  ZALO
}

enum DestinationType {
  PAGE
  PROFILE
  GROUP
  ORGANIZATION
  OA
  OTHER
}

enum PostingMode {
  API
  MANUAL
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum PublicationState {
  PENDING
  SCHEDULED
  PUBLISHING
  PROCESSING
  PUBLISHED
  RETRY_WAITING
  FAILED
  CANCELLED
}

model Job {
  id               String         @id @default(uuid()) @db.Uuid
  title            String
  companyName      String
  description      String
  location         String?
  employmentType   EmploymentType
  status           JobStatus      @default(DRAFT)
  currency         String         @default("VND")
  salaryMinMinor   BigInt?
  salaryMaxMinor   BigInt?
  sourceRef        String?
  commissionNote   String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  posts            Post[]

  @@index([status, updatedAt])
  @@index([employmentType])
  @@map("jobs")
}

model Post {
  id          String        @id @default(uuid()) @db.Uuid
  jobId       String        @db.Uuid
  title       String
  baseContent String
  language    String
  status      PostStatus    @default(DRAFT)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  variants    PostVariant[]

  @@index([jobId])
  @@index([status, updatedAt])
  @@map("posts")
}

model PostVariant {
  id           String        @id @default(uuid()) @db.Uuid
  postId       String        @db.Uuid
  platform     SocialPlatform
  text         String
  hashtags     String[]      @default([])
  link         String?
  metadata     Json          @default("{}")
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  publications Publication[]

  @@unique([postId, platform])
  @@index([postId])
  @@index([platform])
  @@map("post_variants")
}

model SocialAccount {
  id                String              @id @default(uuid()) @db.Uuid
  platform          SocialPlatform
  externalAccountId String
  displayName       String
  status            SocialAccountStatus @default(CONNECTED)
  scopes            String[]            @default([])
  credentialRef     String?
  expiresAt         DateTime?           @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(6)
  destinations      Destination[]
  publications      Publication[]

  @@unique([platform, externalAccountId])
  @@index([platform, status])
  @@index([expiresAt])
  @@map("social_accounts")
}

model Destination {
  id              String          @id @default(uuid()) @db.Uuid
  platform        SocialPlatform
  type            DestinationType
  name            String
  externalId      String?
  url             String?
  postingMode     PostingMode
  enabled         Boolean         @default(true)
  tags            String[]        @default([])
  socialAccountId String?         @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)
  socialAccount   SocialAccount?  @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  publications    Publication[]

  @@index([platform, enabled])
  @@index([postingMode, enabled])
  @@index([socialAccountId])
  @@map("destinations")
}

model Publication {
  id                String           @id @default(uuid()) @db.Uuid
  postVariantId     String           @db.Uuid
  destinationId     String           @db.Uuid
  socialAccountId   String?          @db.Uuid
  state             PublicationState @default(PENDING)
  idempotencyKey    String           @unique
  scheduledAt       DateTime?        @db.Timestamptz(6)
  publishedAt       DateTime?        @db.Timestamptz(6)
  nextRetryAt       DateTime?        @db.Timestamptz(6)
  retryCount        Int              @default(0)
  externalPostId    String?
  externalUrl       String?
  providerRequestId String?
  correlationId     String?
  lastErrorCode     String?
  lastErrorMessage  String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)
  postVariant       PostVariant      @relation(fields: [postVariantId], references: [id], onDelete: Restrict)
  destination       Destination      @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  socialAccount     SocialAccount?   @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@index([state, scheduledAt])
  @@index([state, nextRetryAt])
  @@index([postVariantId])
  @@index([destinationId])
  @@index([socialAccountId])
  @@index([externalPostId])
  @@map("publications")
}
