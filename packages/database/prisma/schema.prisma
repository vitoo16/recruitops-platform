generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  OTHER
}

enum PostStatus {
  DRAFT
  READY
  ARCHIVED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  THREADS
  LINKEDIN
  TIKTOK
  ZALO
}

enum DestinationType {
  PAGE
  PROFILE
  GROUP
  ORGANIZATION
  OA
  OTHER
}

enum PostingMode {
  API
  MANUAL
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum ApplicationStatus {
  SOURCED
  SUBMITTED
  INTERVIEW_INVITED
  INTERVIEWED
  REJECTED
  HIRED
  WORKING
  WORKED_30_DAYS
  WITHDRAWN
}

model Job {
  id               String         @id @default(uuid()) @db.Uuid
  title            String
  companyName      String
  description      String
  location         String?
  employmentType   EmploymentType
  status           JobStatus      @default(DRAFT)
  currency         String         @default("VND")
  salaryMinMinor   BigInt?
  salaryMaxMinor   BigInt?
  sourceRef        String?
  commissionNote   String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  posts            Post[]
  applications     Application[]

  @@index([status, updatedAt])
  @@index([employmentType])
  @@map("jobs")
}

model Post {
  id          String        @id @default(uuid()) @db.Uuid
  jobId       String        @db.Uuid
  title       String
  baseContent String
  language    String
  status      PostStatus    @default(DRAFT)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  variants    PostVariant[]

  @@index([jobId])
  @@index([status, updatedAt])
  @@map("posts")
}

model PostVariant {
  id        String         @id @default(uuid()) @db.Uuid
  postId    String         @db.Uuid
  platform  SocialPlatform
  text      String
  hashtags  String[]       @default([])
  link      String?
  metadata  Json           @default("{}")
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)
  post      Post           @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
  @@index([postId])
  @@index([platform])
  @@map("post_variants")
}

model SocialAccount {
  id                String              @id @default(uuid()) @db.Uuid
  platform          SocialPlatform
  externalAccountId String
  displayName       String
  status            SocialAccountStatus @default(CONNECTED)
  scopes            String[]            @default([])
  credentialRef     String?
  expiresAt         DateTime?           @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(6)
  destinations      Destination[]

  @@unique([platform, externalAccountId])
  @@index([platform, status])
  @@index([expiresAt])
  @@map("social_accounts")
}

model Destination {
  id                  String          @id @default(uuid()) @db.Uuid
  platform            SocialPlatform
  type                DestinationType
  name                String
  externalId          String?
  url                 String?
  postingMode         PostingMode
  enabled             Boolean         @default(true)
  tags                String[]        @default([])
  socialAccountId     String?         @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)
  socialAccount       SocialAccount?  @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  sourcedApplications Application[]   @relation("ApplicationSourceDestination")

  @@index([platform, enabled])
  @@index([postingMode, enabled])
  @@index([socialAccountId])
  @@map("destinations")
}

model Candidate {
  id              String        @id @default(uuid()) @db.Uuid
  fullName        String
  email           String?
  emailNormalized String?
  phone           String?
  phoneNormalized String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  applications    Application[]

  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([updatedAt])
  @@map("candidates")
}

model Application {
  id                  String            @id @default(uuid()) @db.Uuid
  candidateId         String            @db.Uuid
  jobId               String            @db.Uuid
  status              ApplicationStatus @default(SOURCED)
  sourcePlatform      SocialPlatform?
  sourceDestinationId String?           @db.Uuid
  sourceLabel         String?
  sourcedAt           DateTime          @default(now()) @db.Timestamptz(6)
  submittedAt         DateTime?         @db.Timestamptz(6)
  interviewAt         DateTime?         @db.Timestamptz(6)
  hiredAt             DateTime?         @db.Timestamptz(6)
  startedAt           DateTime?         @db.Timestamptz(6)
  worked30DaysAt      DateTime?         @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)
  candidate           Candidate         @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  sourceDestination   Destination?      @relation("ApplicationSourceDestination", fields: [sourceDestinationId], references: [id], onDelete: SetNull)

  @@index([candidateId, updatedAt])
  @@index([jobId, status])
  @@index([sourcePlatform])
  @@index([sourceDestinationId])
  @@index([status, updatedAt])
  @@map("applications")
}
